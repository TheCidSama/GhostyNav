<UserControl x:Class="GhostyNav.Pages.ControlsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel Margin="12,2,12,0">
            <UniformGrid Columns="3" Height="50">
                <ToggleButton x:Name="WifiTile" Style="{StaticResource Tile}" Margin="0,0,4,0" Click="OnWifiClick">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TileChevron}" Content="&#xE70D;"
                                Click="OnWifiMore" ToolTip="Wi-Fi networks" />
                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                            <Ellipse Fill="#000000" Opacity="0.12" />
                            <TextBlock x:Name="WifiIcon" Style="{StaticResource Icon}" Text="&#xE701;" FontSize="13" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Wi-Fi" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="WifiState" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>

                <ToggleButton x:Name="BluetoothTile" Style="{StaticResource Tile}" Margin="4,0" Click="OnBluetoothClick">
                    <DockPanel>
                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                            <Ellipse Fill="#000000" Opacity="0.12" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE702;" FontSize="13" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="BluetoothState" FontSize="10" Opacity="0.7" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>

                <ToggleButton x:Name="AudioTile" Style="{StaticResource Tile}" Margin="4,0,0,0" Click="OnAudioClick"
                              ToolTip="Click to mute">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TileChevron}" Content="&#xE70D;"
                                Click="OnAudioMore" ToolTip="Output device" />
                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                            <Ellipse Fill="#000000" Opacity="0.12" />
                            <TextBlock x:Name="AudioIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="13" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Audio" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="AudioState" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>
            </UniformGrid>

            <Grid Height="46" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="NightTile" Style="{StaticResource Tile}" Margin="0,0,4,0" Click="OnNightClick">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TileChevron}" Content="&#xE70D;"
                                Click="OnNightMore" ToolTip="Night light settings" />
                        <Rectangle DockPanel.Dock="Right" Width="1" Margin="4,10" Fill="#808080" Opacity="0.4" />
                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                            <Ellipse Fill="#000000" Opacity="0.12" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="13" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Night Light" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="NightState" FontSize="10" Opacity="0.7" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>

                <ToggleButton x:Name="DarkTile" Grid.Column="1" Style="{StaticResource Tile}" Margin="4,0" Click="OnDarkClick">
                    <DockPanel>
                        <Grid Width="28" Height="28" Margin="0,0,8,0">
                            <Ellipse Fill="#000000" Opacity="0.12" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7A1;" FontSize="13" />
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Dark mode" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="DarkState" FontSize="10" Opacity="0.7" />
                        </StackPanel>
                    </DockPanel>
                </ToggleButton>

                <!-- Settings: a square tile at the end of the row -->
                <Button x:Name="SettingsTile" Grid.Column="2" Width="46" Margin="4,0,0,0" Click="OnSettings"
                        ToolTip="Settings" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{StaticResource CardBrush}" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="Gear" Style="{StaticResource Icon}" Text="&#xE713;" FontSize="15"
                                           Foreground="{StaticResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                    <!-- The gear turns a little under the pointer -->
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Gear" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 To="60" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Gear" Storyboard.TargetProperty="RenderTransform.Angle"
                                                                 To="0" Duration="0:0:0.35">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Volume: icon and percentage drawn over the slider -->
            <Grid Height="28" Margin="0,8,0,0">
                <Slider x:Name="VolumeSlider" Style="{StaticResource PillSlider}" />
                <TextBlock x:Name="VolumeIcon" Style="{StaticResource Icon}" Text="&#xE767;" FontSize="11"
                           Foreground="{DynamicResource OnAccentBrush}" HorizontalAlignment="Left" Margin="10,0,0,0"
                           IsHitTestVisible="False" />
                <TextBlock x:Name="VolumeText" FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" />
            </Grid>

            <ContentControl x:Name="MediaHost" Margin="0,8,0,0" Height="102" />

            <!-- Takes the media card's place while nothing is playing, if Spotify is installed -->
            <Border x:Name="SpotifyCard" Margin="0,8,0,0" Height="48" Padding="10,0,10,0" Cursor="Hand"
                    Visibility="Collapsed" MouseLeftButtonUp="OnOpenSpotify">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Background="#1ED760" Foreground="#000000"
                            Height="26" FontSize="11" Content="Open" Click="OnOpenSpotify" />
                    <!-- Spotify mark: green disc with three sound waves -->
                    <Grid Width="28" Height="28" Margin="0,0,10,0">
                        <Ellipse Fill="#1ED760" />
                        <Path Stroke="#000000" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 7,10.4 Q 14,7.8 21,11.4" />
                        <Path Stroke="#000000" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 8,14.6 Q 14,12.6 19.8,15.4" />
                        <Path Stroke="#000000" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 9,18.6 Q 14,17.2 18.6,19.2" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Spotify" FontSize="12.5" FontWeight="SemiBold" />
                        <TextBlock Text="Nothing playing" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Output-device picker, shown over the tiles -->
        <Border x:Name="DevicePicker" Visibility="Collapsed" Background="#1A1A1D" CornerRadius="14" Padding="6"
                Margin="12,2,12,0" VerticalAlignment="Top" BorderBrush="#2E2E33" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.6" />
            </Border.Effect>
            <StackPanel>
                <DockPanel Margin="8,4,4,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                            Width="22" Height="22" Click="OnCloseDevices" />
                    <TextBlock Text="Sound output" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel x:Name="DeviceList" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
