<UserControl x:Class="GhostyNav.Pages.TodayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GhostyNav.Controls">
    <Grid Margin="12,2,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="168" />
        </Grid.ColumnDefinitions>

        <!-- Clock + weather -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="88" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="HourText" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="2,0" />
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="2,0" Opacity="0.7" />
                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}" Margin="2,0" Opacity="0.4" />
                    </StackPanel>
                    <TextBlock x:Name="MinuteText" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ClockSub" Style="{StaticResource Label}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Cursor="Hand" MouseLeftButtonUp="OnWeatherClick">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="WeatherIcon" Style="{StaticResource Icon}" FontSize="18" Text="&#xE706;"
                               Foreground="#FFC94D" />
                    <TextBlock x:Name="WeatherTemp" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0" Text="—" />
                    <TextBlock x:Name="WeatherText" Style="{StaticResource Label}" HorizontalAlignment="Center" FontWeight="Normal"
                               TextWrapping="Wrap" TextAlignment="Center" MaxHeight="26" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Week + timer -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="WeekRange" DockPanel.Dock="Right" Style="{StaticResource Label}" FontWeight="Normal" />
                        <TextBlock Text="This week" FontSize="12" FontWeight="SemiBold" />
                    </DockPanel>
                    <UniformGrid x:Name="WeekDays" Columns="7" Margin="0,8,0,0" />
                    <Border Background="#1E1E22" CornerRadius="9" Padding="10,6" Margin="0,9,0,0">
                        <DockPanel>
                            <Border Width="3" CornerRadius="1.5" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock x:Name="NextTitle" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NextSub" FontSize="10" Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="68" Height="68" VerticalAlignment="Center">
                        <c:Ring x:Name="TimerRing" Thickness="4" Stroke="#FFB13D" Value="1" />
                        <TextBlock x:Name="TimerText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <UniformGrid Columns="2">
                            <Grid Margin="0,0,3,0">
                                <TextBox x:Name="HoursBox" Style="{StaticResource Field}" Height="26" FontSize="12" FontWeight="SemiBold"
                                         HorizontalContentAlignment="Right" Padding="8,0,22,0" MaxLength="2" Text="0" />
                                <TextBlock Text="h" Style="{StaticResource Label}" FontWeight="Normal" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,9,0" IsHitTestVisible="False" />
                            </Grid>
                            <Grid Margin="3,0,0,0">
                                <TextBox x:Name="MinutesBox" Style="{StaticResource Field}" Height="26" FontSize="12" FontWeight="SemiBold"
                                         HorizontalContentAlignment="Right" Padding="8,0,30,0" MaxLength="3" Text="05" />
                                <TextBlock Text="min" Style="{StaticResource Label}" FontWeight="Normal" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False" />
                            </Grid>
                        </UniformGrid>
                        <UniformGrid x:Name="Presets" Columns="5" Margin="-2,6,-2,0" />
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Background="#FFB13D" Height="26"
                                    Margin="0,0,3,0" Content="Start" Click="OnStartPause" />
                            <Button Style="{StaticResource FlatButton}" Height="26" Margin="3,0,0,0" Content="Reset" Click="OnReset" />
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- To-dos -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,6">
                    <Grid DockPanel.Dock="Right" Width="22" Height="22">
                        <c:Ring x:Name="TodoRing" Thickness="2.5" Stroke="{StaticResource RamBrush}" />
                        <TextBlock x:Name="TodoCount" FontSize="7.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Today" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBox x:Name="TodoBox" Style="{StaticResource Field}" Height="30" FontSize="11.5" Padding="22,0,30,0"
                             Tag="Add a to-do..." KeyDown="OnTodoKey" MaxLength="120" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="10" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE72A;" FontSize="10" Width="22" Height="22"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                            HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnAddTodo" />
                </Grid>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <StackPanel x:Name="TodoList" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
