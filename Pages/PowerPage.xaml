<UserControl x:Class="GhostyNav.Pages.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UniformGrid Columns="4" Margin="12,2,12,0" VerticalAlignment="Top">
        <Button Style="{StaticResource BigTile}" Margin="0,0,4,0" Click="OnLock">
            <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="15" />
                <TextBlock Text="Lock" FontSize="11.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Button>
        <Button Style="{StaticResource BigTile}" Margin="4,0" Click="OnSleep">
            <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="15" />
                <TextBlock Text="Sleep" FontSize="11.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="RestartButton" Style="{StaticResource BigTile}" Margin="4,0" Click="OnRestart">
            <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="15" />
                <TextBlock x:Name="RestartText" Text="Restart" FontSize="11.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Button>
        <Button x:Name="ShutdownButton" Style="{StaticResource BigTile}" Margin="4,0,0,0" Click="OnShutdown">
            <StackPanel>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="15" />
                <TextBlock x:Name="ShutdownText" Text="Shut down" FontSize="11.5" HorizontalAlignment="Center" Margin="0,7,0,0" />
            </StackPanel>
        </Button>
    </UniformGrid>
</UserControl>
