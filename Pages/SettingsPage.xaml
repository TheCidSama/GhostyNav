<UserControl x:Class="GhostyNav.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="#22FFFFFF" />
            <Setter Property="Margin" Value="0,9" />
        </Style>
    </UserControl.Resources>

    <StackPanel x:Name="Root" Margin="12,2,12,0" VerticalAlignment="Top">
    <!-- Opened from the gear in Controls; the arrow goes back there -->
    <DockPanel Margin="-4,0,0,6">
        <StackPanel x:Name="Sections" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" FontSize="12" Width="28" Height="28"
                    Click="OnBack" ToolTip="Back to Controls" />
            <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,1" />
        </StackPanel>
    </DockPanel>

    <!-- ===== Assistant ===== -->
    <StackPanel x:Name="AssistantSection">
    <Border Style="{StaticResource Card}" Padding="14,12">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="22" Padding="8,0" FontSize="10.5"
                        Background="Transparent" Foreground="{DynamicResource AccentBrush}" Click="OnGetKey"
                        ToolTip="aistudio.google.com/apikey">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Get a key" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="9" Margin="5,1,0,0" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Ellipse Fill="{DynamicResource AccentDimBrush}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                    <TextBlock Text="Gemini API key" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="KeyIntro" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" Margin="33,2,0,10" />

            <Grid>
                <PasswordBox x:Name="KeyBox" Style="{StaticResource PasswordField}" Padding="10,0,66,0"
                             PasswordChanged="OnKeyChanged" KeyDown="OnKeyDown" />
                <TextBlock x:Name="KeyPlaceholder" Text="Paste your API key" Foreground="{StaticResource FaintBrush}"
                           FontSize="12.5" VerticalAlignment="Center" Margin="13,0,70,0" IsHitTestVisible="False" />
                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Height="26" FontSize="11.5" Padding="12,0"
                        HorizontalAlignment="Right" Margin="0,0,4,0" Content="Save" IsEnabled="False" Click="OnSave" />
            </Grid>

            <DockPanel Margin="0,10,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TestButton" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="10,0"
                            Content="Test" Click="OnTest" />
                    <Button x:Name="RemoveButton" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="10,0"
                            Margin="6,0,0,0" Content="Remove" Click="OnRemove" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusText" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>

    <!-- Voice assistant keys, look and sound -->
    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0">
        <StackPanel>
            <DockPanel>
                <StackPanel x:Name="ChordChoices" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Ellipse Fill="#2A2342" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE765;" FontSize="11" Foreground="#C9B6FF" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Talk keys" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Hold both, speak, let go" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Rectangle Style="{StaticResource Divider}" />

            <DockPanel>
                <ToggleButton x:Name="HaloSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnHaloChanged" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Ellipse Fill="#1A2A44" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE793;" FontSize="11" Foreground="#7FB8FF" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Listening halo" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Blue glow on the screen edges that follows your voice" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <Rectangle Style="{StaticResource Divider}" />

            <DockPanel>
                <StackPanel x:Name="VoiceChoices" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Ellipse Fill="{DynamicResource AccentDimBrush}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Spoken replies" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="VoiceHint" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>

    <!-- Routines the assistant set up: visible, and removable, here -->
    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="RoutineCount" DockPanel.Dock="Right" Style="{StaticResource Label}" FontWeight="Normal"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="24" Height="24" Margin="0,0,9,0">
                        <Ellipse Fill="#1E2A1A" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="11" Foreground="{StaticResource RamBrush}" />
                    </Grid>
                    <TextBlock Text="Routines" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="NoRoutines" FontSize="10.5" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                       Margin="33,4,0,0" />
            <ScrollViewer x:Name="RoutineScroll" MaxHeight="104" VerticalScrollBarVisibility="Hidden" Focusable="False" Margin="0,6,0,0">
                <StackPanel x:Name="RoutineList" />
            </ScrollViewer>
        </StackPanel>
    </Border>
    </StackPanel>

    <!-- ===== Notch ===== -->
    <StackPanel x:Name="NotchSection" Visibility="Collapsed">
    <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
            <DockPanel>
                <StackPanel x:Name="SizeChoices" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Notch size" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="How big it is when closed" Style="{StaticResource RowHint}" />
                </StackPanel>
            </DockPanel>
            <Rectangle Style="{StaticResource Divider}" />
            <DockPanel>
                <StackPanel x:Name="AccentChoices" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Accent colour" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="AccentName" Style="{StaticResource RowHint}" />
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="ScreenRow" Visibility="Collapsed">
                <Rectangle Style="{StaticResource Divider}" />
                <DockPanel>
                    <StackPanel x:Name="ScreenChoices" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Screen" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Where the notch sits" Style="{StaticResource RowHint}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0">
        <StackPanel x:Name="MomentSwitches" />
    </Border>

    <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock Text="Tabs" Style="{StaticResource RowTitle}" />
            <TextBlock Text="Controls always stays; the others can go" Style="{StaticResource RowHint}" />
            <WrapPanel x:Name="TabChoices" Margin="-2,8,0,0" />
        </StackPanel>
    </Border>
    </StackPanel>

    <!-- ===== About ===== -->
    <StackPanel x:Name="AboutSection" Visibility="Collapsed">
    <Border Style="{StaticResource Card}" Padding="14,12">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CheckButton" Style="{StaticResource FlatButton}" Height="26" FontSize="11" Padding="10,0"
                            Content="Check now" Click="OnCheckUpdates" />
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Height="26" FontSize="11" Padding="12,0"
                            Margin="6,0,0,0" Visibility="Collapsed" Click="OnUpdate" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="GhostIcon" Width="30" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                        <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowHint}" TextTrimming="CharacterEllipsis" MaxWidth="200" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <Rectangle Style="{StaticResource Divider}" />
            <DockPanel>
                <ToggleButton x:Name="AutoUpdateSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="OnAutoUpdateChanged" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Look for updates" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Once a day, from GitHub. Nothing about you is sent." Style="{StaticResource RowHint}" />
                </StackPanel>
            </DockPanel>
            <Rectangle Style="{StaticResource Divider}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Height="24" FontSize="11" Padding="10,0"
                        Content="Open" Click="OnRepo" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="github.com/TheCidSama/GhostyNav" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Free and open source, MIT license" Style="{StaticResource RowHint}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
    </StackPanel>
    </StackPanel>
</UserControl>
