<UserControl x:Class="GhostyNav.Pages.AppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GhostyNav.Pages">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Vis" />

        <DataTemplate DataType="{x:Type local:AppRow}">
            <Grid>
                <TextBlock Text="{Binding Header}" Style="{StaticResource Label}" FontSize="9.5"
                           Visibility="{Binding IsHeader, Converter={StaticResource Vis}}" />
                <DockPanel Visibility="{Binding IsItem, Converter={StaticResource Vis}}" Height="24">
                    <Border x:Name="Avatar" DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="7" Background="#242428"
                            Margin="0,0,10,0">
                        <Grid>
                            <!-- The letter stands in until the app's icon has loaded (or if it has none) -->
                            <TextBlock x:Name="Letter" Text="{Binding Letter}" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="Icon" Source="{Binding Icon}" Width="24" Height="24" Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Border>
                    <Button x:Name="Star" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="22" Height="22"
                            FontSize="11" Content="{Binding StarGlyph}" Foreground="{DynamicResource AccentBrush}"
                            Visibility="Hidden" Click="OnStar" Tag="{Binding}" ToolTip="Star" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Category}" FontSize="10" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Margin="8,0" />
                    <TextBlock x:Name="Hint" DockPanel.Dock="Right" Text="↵ Open" FontSize="10" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Starred}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWeb}" Value="True">
                    <Setter TargetName="Star" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Letter" Property="FontFamily" Value="{StaticResource IconFont}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                    <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Last, so a real icon sits on no tile even in the selected row -->
                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                    <Setter TargetName="Avatar" Property="Background" Value="Transparent" />
                    <Setter TargetName="Letter" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="12,2,12,0">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" Tag="Search apps or the web..." Padding="34,0,110,0" />
            <Border Style="{StaticResource KeyHint}" HorizontalAlignment="Right" Margin="0,0,10,0">
                <TextBlock Text="Ctrl+Alt+Space" FontSize="9.5" Foreground="{StaticResource SubTextBrush}" />
            </Border>
        </Grid>
        <Grid>
            <ListBox x:Name="List" Style="{StaticResource PlainList}" MouseDoubleClick="OnDoubleClick"
                     MouseLeftButtonUp="OnClick" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="Status" FontSize="11.5" Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
