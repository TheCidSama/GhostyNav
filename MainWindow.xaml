<Window x:Class="GhostyNav.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GhostyNav.Controls"
        Title="GhostyNav"
        Width="640" Height="520" Top="0"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <!-- The window is a fixed transparent canvas big enough for the largest tab.
         Fully transparent pixels of a layered window are click-through, so only the
         black island itself takes input. -->
    <Grid>
        <!-- Voice assistant (mascot + transcript). Behind the notch so the mascot drops out from under it. -->
        <c:AssistantPanel x:Name="AssistantUI" />

        <!-- MacBook-style notch: flush with the top edge, concave "shoulders" blending into the
             screen edge, rounded bottom corners. The outline is rebuilt each animation frame. -->
        <Grid x:Name="Island" VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnStartupToggled" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnExit" />
                </ContextMenu>
            </Grid.ContextMenu>

            <Path x:Name="Shape" Fill="{StaticResource IslandBrush}" />

            <Grid x:Name="Clipper">
                <!-- Compact "live activity": album art + audio bars, or a running timer.
                     Side margins clear the sloped sides at mid-height. -->
                <Grid x:Name="Compact" Height="24" VerticalAlignment="Top" Margin="21,0,22,0">
                    <Border x:Name="CompactArt" Width="16" Height="16" CornerRadius="5"
                            HorizontalAlignment="Left" Background="{StaticResource TrackBrush}" Visibility="Hidden" />
                    <TextBlock x:Name="CompactTimerIcon" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="11"
                               Foreground="#FFB13D" HorizontalAlignment="Left" Visibility="Hidden" />
                    <StackPanel x:Name="Bars" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Height="11" Visibility="Hidden" />
                    <TextBlock x:Name="CompactTimerText" FontSize="11" FontWeight="SemiBold" Foreground="#FFB13D"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                    <!-- Another app is using the microphone (orange) or camera (green), like a phone's dots -->
                    <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0,0,0,1">
                        <Ellipse x:Name="CameraDot" Width="6" Height="6" Fill="#4CD964" Margin="2,0" Visibility="Collapsed"
                                 ToolTip="An app is using the camera" />
                        <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FF9F0A" Margin="2,0" Visibility="Collapsed"
                                 ToolTip="An app is using the microphone" />
                    </StackPanel>
                    <!-- Files on the shelf: hover to see them -->
                    <TextBlock x:Name="CompactShelfIcon" Style="{StaticResource Icon}" Text="&#xE7B8;" FontSize="11"
                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Left" Visibility="Hidden" />
                    <TextBlock x:Name="CompactShelfText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                </Grid>

                <!-- Voice assistant: the notch drops down with the ghost inside, status beside it -->
                <Grid x:Name="AssistantBar" Height="58" VerticalAlignment="Top" Margin="26,0,28,0" Opacity="0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="GhostDrop" />
                        </Border.RenderTransform>
                        <c:Mascot x:Name="Ghost" />
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,6,0,0">
                        <Ellipse x:Name="AssistantDot" Width="7" Height="7" Fill="#C9B6FF" Margin="0,0,7,0" />
                        <TextBlock x:Name="AssistantStatus" FontSize="13" FontWeight="SemiBold" Foreground="#E6DEFF" />
                    </StackPanel>
                    <StackPanel x:Name="LevelBars" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Height="14" Margin="0,6,0,0" />
                </Grid>

                <!-- Peek: mini player on hover / track change, or a notice -->
                <Grid x:Name="Peek" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" Visibility="Collapsed">
                    <ContentControl x:Name="PeekHost" Focusable="False" />
                </Grid>

                <Grid x:Name="Expanded" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ExpandedScale" />
                    </Grid.RenderTransform>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="Tabs" Orientation="Horizontal" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="0,4,0,0" Background="Transparent" />
                    <Grid x:Name="PageHost" Grid.Row="1" Background="Transparent" />
                </Grid>

                <!-- Widget effects (splashes, ripples), clipped to the island like everything else -->
                <Canvas x:Name="FxLayer" IsHitTestVisible="False" />
            </Grid>
        </Grid>
    </Grid>
</Window>
