<UserControl x:Class="GhostyNav.Controls.MediaCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GhostyNav.Controls">
    <Border x:Name="Root" Style="{StaticResource Card}" Padding="12,9,12,10">
        <Grid>
            <Grid x:Name="Player">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="SourceRow" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7F5;" FontSize="10" Foreground="{StaticResource SubTextBrush}" />
                    <TextBlock x:Name="Source" Style="{StaticResource Label}" Margin="5,0,0,0" />
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Art" Width="40" Height="40" CornerRadius="8" Background="{StaticResource TrackBrush}">
                        <TextBlock x:Name="ArtPlaceholder" Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="16"
                                   Foreground="{StaticResource SubTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ArtistText" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE892;" FontSize="12" Width="28" Height="28"
                                Background="#232327" Click="OnPrevious" />
                        <Button x:Name="PlayPause" Style="{StaticResource IconButton}" Content="&#xE768;" FontSize="14"
                                Width="36" Height="36" Margin="6,0" Background="#EDE6D6" Foreground="#111111" Click="OnPlayPause" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE893;" FontSize="12" Width="28" Height="28"
                                Background="#232327" Click="OnNext" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Elapsed" FontSize="10" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" />
                    <!-- Taller transparent hit area around the thin bar; click or drag to seek -->
                    <Grid x:Name="Seekbar" Grid.Column="1" Height="16" Background="Transparent" c:Swipe.Ignore="True"
                          MouseLeftButtonDown="OnSeekStart" MouseMove="OnSeekMove" MouseLeftButtonUp="OnSeekEnd"
                          LostMouseCapture="OnSeekLost" MouseEnter="OnSeekHover" MouseLeave="OnSeekHover">
                        <c:WavyProgress x:Name="Progress" Stroke="{StaticResource AccentBrush}" Track="{StaticResource TrackBrush}" />
                        <Ellipse x:Name="Knob" Width="11" Height="11" Fill="#FFFFFF" HorizontalAlignment="Left"
                                 Visibility="Hidden" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock x:Name="Total" Grid.Column="2" FontSize="10" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Grid>

            <StackPanel x:Name="Empty" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" FontSize="16" Foreground="{StaticResource SubTextBrush}" />
                <TextBlock Text="Nothing playing" FontSize="12" Foreground="{StaticResource SubTextBrush}" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
