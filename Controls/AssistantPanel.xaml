<UserControl x:Class="GhostyNav.Controls.AssistantPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380" VerticalAlignment="Top" HorizontalAlignment="Center" Visibility="Collapsed">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Lavender" Color="#C9B6FF" />
        <SolidColorBrush x:Key="LavenderDim" Color="#2A2342" />
    </UserControl.Resources>
    <!-- The transcript widget, just under the dropped-down notch (58px tall). -->
    <StackPanel>
        <Border x:Name="Card" Margin="0,66,0,0" CornerRadius="18" Background="#F20E0C14" BorderThickness="1"
                Padding="16,12,12,12" Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#8CC9B6FF" Offset="0" />
                    <GradientStop Color="#1FC9B6FF" Offset="0.5" />
                    <GradientStop Color="#66A78BFA" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="0.96" ScaleY="0.96" />
                    <TranslateTransform x:Name="CardShift" Y="-8" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="9"
                        Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                        Foreground="{StaticResource SubTextBrush}" Visibility="Hidden" Click="OnClose" ToolTip="Close" />
                <StackPanel Margin="0,0,18,0">
                    <ScrollViewer x:Name="TranscriptScroll" MaxHeight="88" VerticalScrollBarVisibility="Hidden" Focusable="False">
                        <TextBlock x:Name="Transcript" FontSize="14" TextWrapping="Wrap" LineHeight="20">
                            <Run x:Name="FinalRun" Foreground="#F5F2FF" /><Run x:Name="InterimRun" Foreground="#9C93BC" />
                        </TextBlock>
                    </ScrollViewer>
                    <TextBlock x:Name="Placeholder" FontSize="13" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                               Text="Listening… circle anything on screen to ask about it." />
                    <StackPanel x:Name="CircledRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Border Background="{StaticResource LavenderDim}" CornerRadius="8" Padding="7,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B9;" FontSize="10" Foreground="{StaticResource Lavender}" />
                                <TextBlock x:Name="CircledText" FontSize="10.5" FontWeight="SemiBold" Margin="5,0,0,0"
                                           Foreground="{StaticResource Lavender}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- What the assistant did or said -->
                    <StackPanel x:Name="ResultArea" Margin="0,10,0,0" Visibility="Collapsed">
                        <Rectangle x:Name="Divider" Height="1" Fill="#22FFFFFF" Margin="0,0,0,10" />
                        <StackPanel x:Name="Thinking" Orientation="Horizontal" Visibility="Collapsed">
                            <Ellipse x:Name="Dot1" Width="6" Height="6" Fill="{StaticResource Lavender}" Margin="0,0,4,0" />
                            <Ellipse x:Name="Dot2" Width="6" Height="6" Fill="{StaticResource Lavender}" Margin="0,0,4,0" />
                            <Ellipse x:Name="Dot3" Width="6" Height="6" Fill="{StaticResource Lavender}" Margin="0,0,10,0" />
                            <TextBlock x:Name="ThinkingText" Text="Thinking" FontSize="12.5" Foreground="{StaticResource SubTextBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="Results" />
                        <ScrollViewer x:Name="AnswerScroll" MaxHeight="150" VerticalScrollBarVisibility="Hidden" Focusable="False"
                                      Visibility="Collapsed">
                            <TextBlock x:Name="Answer" FontSize="13.5" TextWrapping="Wrap" LineHeight="20" Foreground="#E9E4FF" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
